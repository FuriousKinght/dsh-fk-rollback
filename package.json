    },
    "./package.json": "./package.json"
  },
  "files": [
    "entry.js",
    "lib",
    "cordis.patch.yml",
    "dsh-rollback.mjs",
    "还原DSH配置.bat",
    "README.md",
    "install.mjs",
    "安装.bat"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.15"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
